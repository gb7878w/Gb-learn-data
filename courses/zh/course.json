            { "id": "zh-cha", "kind": "character", "text": "茶", "romanization": "chá", "translation": "thé", "accept": ["le thé", "du thé"], "emoji": "🍵" },
            { "id": "zh-mifan", "kind": "word", "text": "米饭", "romanization": "mǐ fàn", "translation": "riz", "accept": ["riz cuit", "du riz"], "emoji": "🍚" },
