  "description": "Les tons, les premiers caractères simplifiés et les phrases essentielles du mandarin.",
  "units": [
    {
      "id": "zh-u1",
      "title": "Premiers pas",
      "level": "A0",
      "lessons": [
        {
          "id": "zh-u1-l1",
          "title": "Salutations",
          "emoji": "👋",
          "tip": "Le mandarin a quatre tons : ā (haut et plat), á (montant), ǎ (descendant puis montant), à (descendant). Le ton change le sens du mot.",
          "items": [
            { "id": "zh-nihao", "kind": "phrase", "text": "你好", "romanization": "nǐ hǎo", "translation": "bonjour", "accept": ["salut"], "emoji": "👋", "note": "Deux 3ᵉ tons de suite : le premier se prononce au 2ᵉ ton (« ní hǎo »)." },
            { "id": "zh-ninhao", "kind": "phrase", "text": "您好", "romanization": "nín hǎo", "translation": "bonjour (poli)", "accept": ["bonjour"], "emoji": "🙇" },
            { "id": "zh-zaijian", "kind": "phrase", "text": "再见", "romanization": "zài jiàn", "translation": "au revoir", "emoji": "🚪" },
            { "id": "zh-zaoshang-hao", "kind": "phrase", "text": "早上好", "romanization": "zǎo shang hǎo", "translation": "bonjour (le matin)", "accept": ["bonjour"], "emoji": "🌅" },
            { "id": "zh-wanan", "kind": "phrase", "text": "晚安", "romanization": "wǎn ān", "translation": "bonne nuit", "emoji": "🌙" },
            { "id": "zh-ni-hao-ma", "kind": "sentence", "text": "你好吗？", "romanization": "nǐ hǎo ma?", "translation": "comment vas-tu ?", "accept": ["ça va ?", "comment ça va ?"], "emoji": "🤔", "note": "吗 (ma) transforme une affirmation en question." }
          ]
        },
        {
          "id": "zh-u1-l2",
          "title": "Politesse",
          "emoji": "🙏",
          "items": [
            { "id": "zh-xiexie", "kind": "word", "text": "谢谢", "romanization": "xiè xie", "translation": "merci", "emoji": "💐" },
            { "id": "zh-bu-keqi", "kind": "phrase", "text": "不客气", "romanization": "bú kè qi", "translation": "de rien", "accept": ["je vous en prie"], "emoji": "😊" },
            { "id": "zh-duibuqi", "kind": "phrase", "text": "对不起", "romanization": "duì bu qǐ", "translation": "pardon", "accept": ["désolé", "désolée"], "emoji": "😔" },
            { "id": "zh-qing", "kind": "character", "text": "请", "romanization": "qǐng", "translation": "s'il vous plaît", "accept": ["s'il te plaît", "je vous prie"], "emoji": "🙏" },
            { "id": "zh-shi", "kind": "character", "text": "是", "romanization": "shì", "translation": "oui (c'est ça)", "accept": ["oui", "être"], "emoji": "✅" },
            { "id": "zh-bu", "kind": "character", "text": "不", "romanization": "bù", "translation": "non (ne… pas)", "accept": ["non", "ne pas"], "emoji": "❌", "note": "不 devient « bú » devant un 4ᵉ ton : 不客气 bú kè qi." }
          ]
        },
        {
          "id": "zh-u1-l3",
          "title": "Se présenter",
          "emoji": "🧑",
          "tip": "Les pronoms ne changent jamais de forme ; on ajoute 们 (men) pour le pluriel : 我们 = nous.",
          "items": [
            { "id": "zh-wo", "kind": "character", "text": "我", "romanization": "wǒ", "translation": "je", "accept": ["moi"], "emoji": "🧑" },
            { "id": "zh-ni", "kind": "character", "text": "你", "romanization": "nǐ", "translation": "tu", "accept": ["toi"], "emoji": "👉" },
            { "id": "zh-ta", "kind": "character", "text": "他", "romanization": "tā", "translation": "il", "accept": ["lui"], "emoji": "👨" },
            { "id": "zh-wo-jiao", "kind": "phrase", "text": "我叫…", "romanization": "wǒ jiào…", "translation": "je m'appelle…", "emoji": "📛" },
            { "id": "zh-ni-jiao-shenme", "kind": "sentence", "text": "你叫什么名字？", "romanization": "nǐ jiào shén me míng zi?", "translation": "comment t'appelles-tu ?", "accept": ["comment tu t'appelles ?", "quel est ton nom ?"], "emoji": "❓" },
            { "id": "zh-wo-shi-faguoren", "kind": "sentence", "text": "我是法国人", "romanization": "wǒ shì fǎ guó rén", "translation": "je suis français", "accept": ["je suis française"], "emoji": "🇫🇷" }
          ]
        }
      ]
    },
