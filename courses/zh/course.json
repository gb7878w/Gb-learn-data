            { "id": "zh-duoshao-qian", "kind": "sentence", "text": "多少钱？", "romanization": "duō shao qián?", "translation": "combien ça coûte ?", "accept": ["c'est combien ?", "combien ?"], "emoji": "💴" },
            { "id": "zh-maidan", "kind": "word", "text": "买单", "romanization": "mǎi dān", "translation": "l'addition", "accept": ["l'addition s'il vous plaît"], "emoji": "🧾" },
            { "id": "zh-haochi", "kind": "word", "text": "好吃", "romanization": "hǎo chī", "translation": "délicieux", "accept": ["bon", "c'est bon"], "emoji": "😋" },
