            { "id": "zh-qi", "kind": "character", "text": "七", "romanization": "qī", "translation": "sept", "accept": ["7"], "emoji": "7️⃣" },
            { "id": "zh-ba", "kind": "character", "text": "八", "romanization": "bā", "translation": "huit", "accept": ["8"], "emoji": "8️⃣" },
