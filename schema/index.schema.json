{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalogue des cours GB Learn",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "courses"],
  "properties": {
    "formatVersion": { "const": 1 },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    }
  }
}
